# ===== Supabase (Lovable Cloud injeta estas automaticamente) =====
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # só no servidor — necessário para criar encomendas/pagamentos
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ===== M-Pesa Moçambique (Vodacom) — https://developer.mpesa.vm.co.mz =====
# Cria uma aplicação no portal, activa a API "C2B Payment (single stage)" e copia:
MPESA_API_KEY=                    # API Key da aplicação
MPESA_PUBLIC_KEY=                 # Public Key (base64 numa linha, ou PEM com \n)
MPESA_SERVICE_PROVIDER_CODE=171717 # Código do comerciante (171717 no sandbox)
MPESA_AMBIENTE=sandbox            # sandbox | producao
# MPESA_ORIGIN=developer.mpesa.vm.co.mz

# ===== e-Mola (Movitel) — gateway BCCS (SOAP), credenciais fornecidas pela Movitel =====
EMOLA_URL=                        # endereço do web service (UAT ou produção)
EMOLA_USERNAME=
EMOLA_PASSWORD=
EMOLA_PARTNER_CODE=
EMOLA_KEY=
EMOLA_AMBIENTE=sandbox            # sandbox | producao
# EMOLA_CALLBACK_SECRET=           # opcional: exige ?segredo=... ou header x-callback-secret no callback

# ===== Modo de simulação =====
# Sem credenciais, em desenvolvimento, os pagamentos são simulados (confirmam-se sozinhos em ~8s).
# Em produção a simulação está desligada a menos que definas explicitamente:
# PAGAMENTOS_SIMULACAO=true
